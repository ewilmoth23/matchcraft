MATCHCRAFT_ENV=development
MATCHCRAFT_LOG_LEVEL=INFO
MATCHCRAFT_DATABASE_URL=
MATCHCRAFT_DATA_DIR=~/.local/share/matchcraft
MATCHCRAFT_CORS_ORIGINS=http://localhost:5173
MATCHCRAFT_ALLOWED_HOSTS=localhost,127.0.0.1
MATCHCRAFT_MAX_UPLOAD_BYTES=10485760
MATCHCRAFT_PROVIDER=local_first
MATCHCRAFT_OLLAMA_URL=http://localhost:11434
MATCHCRAFT_OPENAI_BASE_URL=https://api.openai.com/v1
MATCHCRAFT_OPENAI_API_KEY=
MATCHCRAFT_MODEL=qwen3.5:9b
MATCHCRAFT_REMOTE_MODEL=gpt-5.6-sol
MATCHCRAFT_OPENAI_REASONING_EFFORT=low
MATCHCRAFT_OLLAMA_CONTEXT_TOKENS=32768
MATCHCRAFT_MODEL_TEMPERATURE=0
MATCHCRAFT_MODEL_MAX_TOKENS=3000
MATCHCRAFT_MODEL_TIMEOUT_SECONDS=180
MATCHCRAFT_MODEL_RETRIES=1
VITE_API_URL=http://localhost:8000/api/v1
